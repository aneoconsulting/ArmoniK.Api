<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Company>ANEO</Company>
    <Copyright>Copyright (C) ANEO, 2021-2026</Copyright>
    <IsPackable>false</IsPackable>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>Embedded</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <PackageVersion>3.29.2</PackageVersion>
    <Version>3.29.2</Version>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArmoniK.Api.TransportOptionsGenerator\ArmoniK.Api.TransportOptionsGenerator.csproj" />
  </ItemGroup>

  <!-- The golden file is compiled here as well as read: compiling it is what proves it is valid C#,
       that its namespace is the one asked for, and that its escapes close. -->
  <ItemGroup>
    <Content Include="Fixtures\http_config.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\TransportOptions.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
