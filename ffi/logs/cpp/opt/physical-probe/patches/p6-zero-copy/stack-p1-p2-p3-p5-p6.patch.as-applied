@@ -45,7 +45,7 @@ corpus = ["ak-abi/corpus"]
 # ABI v1 section 9, behind a feature so a codec arm does not link tonic and tokio into the
 # shared object it is timing. The rust slice turns it on; the cpp slice turns it on for its
 # RPC arm only; the java and csharp slices do not have one.
-rpc = ["dep:rpc", "dep:tonic", "dep:tokio", "dep:bytes", "dep:http"]
+rpc = ["dep:rpc", "dep:tonic", "dep:tokio", "dep:bytes", "dep:http", "dep:hyper", "dep:tokio-stream"]
 
