+/// Runs once when every external piece of a message has been dropped (written or discarded).
+pub struct ZcRelease(pub Option<Box<dyn FnOnce() + Send + Sync>>);
+impl Drop for ZcRelease {
+    fn drop(&mut self) {
+        if let Some(f) = self.0.take() {
