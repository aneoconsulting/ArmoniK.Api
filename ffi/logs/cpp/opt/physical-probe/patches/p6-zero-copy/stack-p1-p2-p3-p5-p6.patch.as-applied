+/// EXPERIMENT p5-deferred: one request message ENCODED BY THE TRANSPORT. `f(user, enc)` is the
+/// host's encode into `enc` (its return value < 0 is an error); the core calls it on the worker
+/// that writes the call, when the body asks for the message, and takes the result framed.
+/// wait = 1: returns after that encode, with its outcome (the host may reuse its value then);
+/// wait = 0: returns once queued, and the host keeps `user`'s value and `enc` untouched until
+/// the NEXT send on this call returns or the recv completes (the channel holds one message, so
+/// by then the transport has taken and encoded this one). Framed streams only; the client's
+/// send limit is not checked on this path (experiment).
+#[no_mangle]
+pub unsafe extern "C" fn ak_call_send_deferred(h: *mut ak_call, enc: *mut crate::ak_enc_ctx, f: AkEncodeFn, user: *mut c_void, last: i32, wait: i32) -> i32 {
+    fwd();
+    if h.is_null() || enc.is_null() {
+        return AK_ERR_INVALID_STATE;
+    }
+    if !(*(h as *mut CallImpl)).stream.as_ref().map_or(false, |s| s.preframed) {
+        return AK_ERR_INVALID_STATE;
+    }
+    let (st, tx) = match send_begin(h, 0, "ak_call_send_deferred") {
+        Ok(v) => v,
+        Err(e) => return e,
+    };
+    let (dtx, drx) = if wait != 0 {
+        let (a, b) = std::sync::mpsc::sync_channel(1);
+        (Some(a), Some(b))
+    } else {
+        (None, None)
+    };
+    let sent = tx.blocking_send(Item::D(Deferred { f, user: user as usize, enc: enc as usize, done: dtx })).is_ok();
+    let rc = send_end(&st.tx, tx, sent, last, "ak_call_send_deferred");
+    if rc != AK_OK {
+        return rc;
+    }
+    match drx {
+        Some(r) => match r.recv() {
+            Ok(code) => code,
+            Err(_) => AK_ERR_HOST,
+        },
+        None => AK_OK,
+    }
+}
+
+/// EXPERIMENT p6-zero-copy: blobs of at least `min_len` bytes (0 = off) that this context
+/// encodes are left in the host's memory (the encoder records where they go instead of copying
+/// them); only ak_call_send_enc_zc may take such a context's output.
+#[no_mangle]
+pub unsafe extern "C" fn ak_enc_set_zc(enc: *mut crate::ak_enc_ctx, min_len: usize) -> i32 {
+    fwd();
+    if enc.is_null() {
+        return AK_ERR_INVALID_STATE;
+    }
+    (*(enc as *mut crate::EncCtxImpl)).e.zc_min = min_len;
+    AK_OK
+}
+
+/// EXPERIMENT p6-zero-copy: `ak_call_send_enc` for a zero-copy context: the message is sent
+/// as its buffer's pieces and the host's blobs themselves, not copied. Lifetime contract: the
+/// memory of every blob the message borrowed stays valid and unmodified until `release(user)`
+/// is called, once per message, from any thread, after the transport has written or dropped
+/// the last borrowed piece (a cancelled or failed call releases too). Blocking otherwise as
+/// ak_call_send_enc (returns once queued). Framed streams only; send limit not checked.
+#[no_mangle]
+pub unsafe extern "C" fn ak_call_send_enc_zc(h: *mut ak_call, enc: *mut crate::ak_enc_ctx, last: i32, release: unsafe extern "C" fn(*mut c_void), user: *mut c_void) -> i32 {
+    fwd();
+    if h.is_null() || enc.is_null() {
+        return AK_ERR_INVALID_STATE;
+    }
+    if !(*(h as *mut CallImpl)).stream.as_ref().map_or(false, |s| s.preframed) {
