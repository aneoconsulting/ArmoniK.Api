 /// call's task through a bounded channel (`ak_call_send` blocks while it is full, so the
 /// host cannot run ahead of the transport by more than one message); the response comes
 /// back on a oneshot (`ak_call_recv`).
+/// EXPERIMENT p5-deferred: a queued request message, or a DEFERRED one that the transport
+/// encodes when its body asks for it (`ak_call_send_deferred`): the host's encode callback
+/// runs on the core's worker that then writes the message, into the host's encode context,
+/// and the result is taken framed exactly as `ak_call_send_enc` takes it.
+enum Item {
+    B(Bytes),
+    D(Deferred),
+    /// EXPERIMENT p6-zero-copy: one message as pieces (its buffer cut around borrowed host
+    /// blobs), yielded as consecutive body frames.
+    P(Vec<Bytes>),
+}
+struct Deferred {
+    f: AkEncodeFn,
+    user: usize,
+    enc: usize,
+    /// Signalled after the encode (its rc) when the host waits for it.
+    done: Option<std::sync::mpsc::SyncSender<i32>>,
+}
+pub type AkEncodeFn = unsafe extern "C" fn(user: *mut c_void, enc: *mut crate::ak_enc_ctx) -> i32;
+
+/// The request stream of a call: queued messages as they are, deferred ones encoded here.
+struct ItemStream {
+    rx: tokio::sync::mpsc::Receiver<Item>,
+    failed: bool,
+    parts: std::collections::VecDeque<Bytes>,
+}
+impl tokio_stream::Stream for ItemStream {
+    type Item = Bytes;
+    fn poll_next(mut self: core::pin::Pin<&mut Self>, cx: &mut core::task::Context<'_>) -> core::task::Poll<Option<Bytes>> {
+        if self.failed {
+            return core::task::Poll::Ready(None);
+        }
+        if let Some(b) = self.parts.pop_front() {
+            return core::task::Poll::Ready(Some(b));
+        }
+        match self.rx.poll_recv(cx) {
+            core::task::Poll::Ready(Some(Item::B(b))) => core::task::Poll::Ready(Some(b)),
+            core::task::Poll::Ready(Some(Item::P(v))) => {
+                self.parts = v.into();
+                core::task::Poll::Ready(self.parts.pop_front())
+            }
+            core::task::Poll::Ready(Some(Item::D(d))) => {
+                rev();
+                let rc = unsafe { (d.f)(d.user as *mut c_void, d.enc as *mut crate::ak_enc_ctx) };
+                let r = if rc < 0 { Err(rc) } else { unsafe { enc_take(d.enc as *mut crate::ak_enc_ctx) } };
+                let code = match &r {
+                    Ok(_) => AK_OK,
+                    Err(e) => *e,
+                };
+                if let Some(tx) = d.done {
+                    let _ = tx.send(code);
+                }
+                match r {
+                    Ok((b, _pre)) => core::task::Poll::Ready(Some(b)),
+                    Err(_) => {
+                        // The request stream ends here: the server sees fewer messages.
+                        self.failed = true;
+                        core::task::Poll::Ready(None)
+                    }
+                }
+            }
+            core::task::Poll::Ready(None) => core::task::Poll::Ready(None),
+            core::task::Poll::Pending => core::task::Poll::Pending,
+        }
+    }
+}
