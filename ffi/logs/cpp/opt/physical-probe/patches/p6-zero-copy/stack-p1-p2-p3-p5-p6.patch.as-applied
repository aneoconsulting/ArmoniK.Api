@@ -56,3 +56,7 @@ tonic = { workspace = true, features = ["codegen", "transport"], optional = true
 tokio = { workspace = true, features = ["rt-multi-thread", "net", "time", "sync", "macros"], optional = true }
 bytes = { workspace = true, optional = true }
 http = { workspace = true, optional = true }
+# EXPERIMENT p3-exec-slot: hyper::rt::Executor for the host executor slot.
+hyper = { version = "1", default-features = false, optional = true }
+# EXPERIMENT p5-deferred: the Stream trait for the request stream adapter.
+tokio-stream = { workspace = true, optional = true }
