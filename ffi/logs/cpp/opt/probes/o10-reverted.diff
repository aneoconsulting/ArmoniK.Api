+/// Optimisation O-10 (ii) (2026-09-28, the cpp slice's optimisation unit, owner-approved):
+/// the copy of a host message into a request body (`ak_call_unary`, `ak_call_send`) lands in
+/// a RECYCLED buffer. The body's buffer returns to this pool when its last `Bytes` is dropped
+/// (on the reference path tonic drops each message once it is copied into its encode buffer;
+/// on the framed path once it is written), so a steady state of calls allocates no body
+/// buffer. At most `COPY_POOL_MAX` buffers are kept; a full or contended pool frees.
+static COPY_POOL: std::sync::Mutex<Vec<Vec<u8>>> = std::sync::Mutex::new(Vec::new());
+const COPY_POOL_MAX: usize = 16;
+
+struct Pooled(Vec<u8>);
+impl AsRef<[u8]> for Pooled {
+    fn as_ref(&self) -> &[u8] {
+        &self.0
+    }
+}
+impl Drop for Pooled {
+    fn drop(&mut self) {
+        if let Ok(mut g) = COPY_POOL.try_lock() {
+            if g.len() < COPY_POOL_MAX {
+                let mut v = core::mem::take(&mut self.0);
+                v.clear();
+                g.push(v);
+            }
+        }
+    }
+}
+
+fn copy_body(src: &[u8]) -> Bytes {
+    let mut v = COPY_POOL.lock().ok().and_then(|mut g| g.pop()).unwrap_or_default();
+    v.reserve_exact(src.len());
+    v.extend_from_slice(src);
+    Bytes::from_owner(Pooled(v))
+}
