+/// EXPERIMENT p9-cb-at-take (not committed): a queued send's completion. The sender travels
+/// with the message and goes back to the call's slot when the body takes it (dropped after the
+/// last message, which ends the request stream); a message dropped untaken (cancel, failure)
+/// completes AK_ERR_HOST from Drop, as a cancelled pending send does on the task path.
+struct Pend {
+    b: Option<Bytes>,
+    sink: Option<Sink>,
+    tag: u64,
+    last: i32,
+    tx: Option<tokio::sync::mpsc::Sender<Item>>,
+    slot: std::sync::Arc<std::sync::Mutex<Option<tokio::sync::mpsc::Sender<Item>>>>,
+}
+impl Pend {
+    fn complete(&mut self, taken: bool) {
+        if let Some(tx) = self.tx.take() {
+            if taken && self.last == 0 {
+                if let Ok(mut g) = self.slot.lock() {
+                    *g = Some(tx);
+                }
+            }
+        }
+        if let Some(sink) = self.sink.take() {
+            let status = if taken { AK_OK } else { AK_ERR_HOST };
+            let grpc_status = if taken { 0 } else { -1 };
+            sink.deliver(ak_completion { tag: self.tag, status, grpc_status, bytes: empty_ak_bytes() });
+        }
+    }
+}
+impl Drop for Pend {
+    fn drop(&mut self) {
+        self.complete(false);
+    }
+}
