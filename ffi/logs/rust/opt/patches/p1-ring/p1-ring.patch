 /// logs/rust/opt/framed-default/ring-size).
 pub const SPARES: usize = 3;
 
+/// EXPERIMENT (patch p1-ring, not committed): the ring's size from AK_SPARES (default SPARES)
+/// and, with AK_SPARE_LOCK=1, a returned buffer waits for the lock instead of being freed when
+/// `try_lock` fails. Read once per process.
+fn spares() -> usize {
+    static S: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *S.get_or_init(|| std::env::var("AK_SPARES").ok().and_then(|v| v.parse().ok()).unwrap_or(SPARES))
+}
+fn spare_lock() -> bool {
+    static S: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *S.get_or_init(|| std::env::var("AK_SPARE_LOCK").map_or(false, |v| v == "1"))
+}
+
