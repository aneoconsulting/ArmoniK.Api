+thread_local! {
+    static DEFERRED_RELEASE: core::cell::Cell<Option<(unsafe extern "C" fn(*mut c_void), usize)>> = const { core::cell::Cell::new(None) };
+}
+
+/// EXPERIMENT p7-deferred-zc: `ak_call_send_deferred` for a context with zero copy on
+/// (`ak_enc_set_zc`): the encode on the transport's worker writes the message's head and
+/// records the host's large blobs as borrowed, and the message goes out as pieces. Lifetime
+/// contract: the value `user` reaches stays untouched as for ak_call_send_deferred, and the
+/// borrowed blobs' memory stays valid and unmodified until `release(ruser)` runs (once per
+/// message, any thread, after the last borrowed piece is written or dropped).
+#[no_mangle]
+pub unsafe extern "C" fn ak_call_send_deferred_zc(h: *mut ak_call, enc: *mut crate::ak_enc_ctx, f: AkEncodeFn, user: *mut c_void, last: i32, wait: i32, release: unsafe extern "C" fn(*mut c_void), ruser: *mut c_void) -> i32 {
+    DEFERRED_RELEASE.with(|r| r.set(Some((release, ruser as usize))));
+    let rc = ak_call_send_deferred(h, enc, f, user, last, wait);
+    DEFERRED_RELEASE.with(|r| r.set(None));
+    rc
+}
