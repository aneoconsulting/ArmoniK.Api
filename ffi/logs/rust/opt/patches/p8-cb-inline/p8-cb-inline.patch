 /// The callback/queue deliveries of a send: the same prologue and epilogue around the
 /// awaited `send`, on a task; the completion (empty bytes) after the sender is back, so the
 /// host may send the next message from inside it.
+/// EXPERIMENT p8-cb-inline (not committed): AK_CB_INLINE=1 (read once) makes a callback/queue
+/// send whose message fits in the channel complete INLINE: try_send, the sender back in its
+/// slot, and the completion delivered before the entry returns, on the caller's thread. Only
+/// when the channel is full does the send go to a task, as it always does without the knob.
+/// Counters: ak_exp_cb_stats(out[2]) = inline completions, spawned sends.
+fn cb_inline() -> bool {
+    static S: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *S.get_or_init(|| std::env::var("AK_CB_INLINE").map_or(false, |v| v == "1"))
+}
+static CB_INLINE_N: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+static CB_SPAWN_N: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+#[no_mangle]
+pub unsafe extern "C" fn ak_exp_cb_stats(out: *mut u64) {
+    if !out.is_null() {
+        *out = CB_INLINE_N.load(core::sync::atomic::Ordering::Relaxed);
+        *out.add(1) = CB_SPAWN_N.load(core::sync::atomic::Ordering::Relaxed);
+    }
+}
