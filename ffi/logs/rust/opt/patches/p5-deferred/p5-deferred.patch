+/// EXPERIMENT p5-deferred: one request message ENCODED BY THE TRANSPORT. `f(user, enc)` is the
+/// host's encode into `enc` (its return value < 0 is an error); the core calls it on the worker
+/// that writes the call, when the body asks for the message, and takes the result framed.
+/// wait = 1: returns after that encode, with its outcome (the host may reuse its value then);
+/// wait = 0: returns once queued, and the host keeps `user`'s value and `enc` untouched until
+/// the NEXT send on this call returns or the recv completes (the channel holds one message, so
+/// by then the transport has taken and encoded this one). Framed streams only; the client's
+/// send limit is not checked on this path (experiment).
+#[no_mangle]
+pub unsafe extern "C" fn ak_call_send_deferred(h: *mut ak_call, enc: *mut crate::ak_enc_ctx, f: AkEncodeFn, user: *mut c_void, last: i32, wait: i32) -> i32 {
+    fwd();
+    if h.is_null() || enc.is_null() {
+        return AK_ERR_INVALID_STATE;
+    }
+    if !(*(h as *mut CallImpl)).stream.as_ref().map_or(false, |s| s.preframed) {
+        return AK_ERR_INVALID_STATE;
+    }
+    let (st, tx) = match send_begin(h, 0, "ak_call_send_deferred") {
+        Ok(v) => v,
+        Err(e) => return e,
+    };
