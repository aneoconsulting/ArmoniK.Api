+    if rc != AK_OK {
+        return rc;
+    }
+    match drx {
+        Some(r) => match r.recv() {
+            Ok(code) => code,
+            Err(_) => AK_ERR_HOST,
+        },
+        None => AK_OK,
+    }
+}
