+        let (a, b) = std::sync::mpsc::sync_channel(1);
+        (Some(a), Some(b))
+    } else {
+        (None, None)
+    };
+    let sent = tx.blocking_send(Item::D(Deferred { f, user: user as usize, enc: enc as usize, done: dtx })).is_ok();
