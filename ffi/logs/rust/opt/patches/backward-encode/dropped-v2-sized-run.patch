+    /// v2: a packed run of varints written FORWARD into a hole of exactly its size: one
+    /// pass sums the values' varint lengths, a second stores them in array order (the
+    /// forward encoder's store loop). No walk order to choose; the bytes are the same.
+    #[inline(always)]
+    pub fn varint_run_sized<I: Iterator<Item = u64> + Clone>(&mut self, it: I) {
+        let total: usize = it.clone().map(varint_len).sum();
+        unsafe {
+            let p = self.hole(total);
+            let mut at = 0usize;
+            for v in it {
+                at += put_varint(p.add(at), v);
+            }
+            debug_assert_eq!(at, total);
+        }
+    }
+
     /// A packed run of doubles: the host's array is contiguous and little-endian, so it is
     /// one copy into the region below the cursor (the bytes of a forward array placed as one
     /// block are in forward order; nothing to walk).
@@ -631,5 +647,12 @@
         f.varint_run(vals.len(), vals.iter().map(|&v| v as u64));
         f.end(mk);
         assert_eq!(e.msg(), &f.buf[..]);
+        // v2: the same run written forward into a sized hole
+        let mut e2 = BEnc::new();
+        e2.reset();
+        let m = e2.open();
+        e2.varint_run_sized(vals.iter().map(|&v| v as u64));
+        e2.close(m, 4);
+        assert_eq!(e2.msg(), &f.buf[..]);
     }
 }
