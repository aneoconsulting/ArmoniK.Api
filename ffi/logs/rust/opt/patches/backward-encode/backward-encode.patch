index 00000000..ab5ed01c
--- /dev/null
+++ b/ffi/poc/rust/crates/harness/src/bwd_tests.rs
@@ -0,0 +1,428 @@
+//! EXPERIMENT backward-encode (ffi/logs/rust/opt/patches/backward-encode/): the host
+//! contract this core needs, exercised by hand-written hosts that deliver every repeated
+//! field LAST TO FIRST in several forms, against the incumbent's bytes.
+//!
+//! Contract under test: within one repeated field the host delivers elements last to first
+//! across all its calls; each call's array (a chunk of element groups, an ak_str run, a
+//! packed run) holds its elements in FORWARD order and the codec walks it last to first.
+//!
+//! Forms per field: `One` (n = 1 per call), `Chunk(k)` (k per call, the remainder last),
+//! `Mixed` (call sizes cycling 1, 7, 3, 12, 2: forms changing mid-field), `Whole` (one call).
+//! Oracle: the facade's prost impl (`armonik` arm, independent of the core), byte for byte;
+//! for packed runs delivered in several calls (several packed records: legal wire, not
+//! prost's bytes) the oracle is prost's DECODE of the output, compared with the value.
+
+use crate::generated::binding::*;
+use ak_abi::*;
+use core::ffi::c_void;
+use std::cell::Cell;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Form {
+    One,
+    Chunk(usize),
+    Mixed,
+    Whole,
+}
+
+thread_local! {
+    static FORM: Cell<Form> = const { Cell::new(Form::Whole) };
+    /// Strings: also vary the transcoder per element (trusted run / validating utf8 /
+    /// latin1 / utf16), so the transcoder paths (known length, region + move) are crossed.
+    static MIX_TC: Cell<bool> = const { Cell::new(false) };
+    /// Fail the operation (ak_fail, AK_ERR_HOST) on the Nth element call of any field.
+    static FAIL_AT: Cell<i64> = const { Cell::new(-1) };
+    static CALLS: Cell<i64> = const { Cell::new(0) };
+}
+
+fn form() -> Form {
+    FORM.with(|f| f.get())
+}
+
+/// Call sizes for a field of `total` elements, the first delivered call covering the LAST
+/// elements.
+fn sizes(total: usize, f: Form) -> Vec<usize> {
+    let mut out = Vec::new();
+    let mut left = total;
+    let cyc = [1usize, 7, 3, 12, 2];
+    let mut k = 0;
+    while left > 0 {
+        let s = match f {
+            Form::One => 1,
+            Form::Chunk(c) => c,
+            Form::Mixed => {
+                k += 1;
+                cyc[(k - 1) % cyc.len()]
+            }
+            Form::Whole => left,
+        }
+        .min(left);
+        out.push(s);
+        left -= s;
+    }
+    out
+}
+
+/// Deliver [0, total) last to first: `call(start, n)` covers elements start..start+n.
+unsafe fn deliver(ctx: *mut ak_enc_ctx, total: usize, mut call: impl FnMut(usize, usize) -> i32) -> i32 {
+    // The planted control (AK_BWD_PLANT=forward): the committed contract's FORWARD order
+    // against this core. Every multi-element field must then come out wrong.
+    let plant = std::env::var_os("AK_BWD_PLANT").is_some_and(|v| v == "forward");
+    let mut end = total;
+    let mut fwd = 0usize;
+    for s in sizes(total, form()) {
+        let start = if plant { fwd } else { end - s };
+        fwd += s;
+        let c = CALLS.with(|c| {
+            let v = c.get();
+            c.set(v + 1);
+            v
+        });
+        if FAIL_AT.with(|f| f.get()) == c {
+            let m = b"planted host failure mid-field";
+            ak_fail(ctx as *mut c_void, AK_ERR_HOST, m.as_ptr(), m.len() as u32);
+            return AK_ERR_HOST;
+        }
+        let rc = call(start, s);
+        if rc < 0 {
+            return rc;
+        }
+        end = start;
+    }
+    AK_OK
+}
+
+/// The element's strings with the transcoder of position `i` when MIX_TC is on. The
+/// payloads' strings are ASCII, so latin1 and UTF-16 transcode to the same bytes.
+struct StrArgs {
+    v: Vec<ak_str>,
+    _u16: Vec<Vec<u16>>,
+}
+fn str_args(src: &[String]) -> StrArgs {
+    let mix = MIX_TC.with(|m| m.get());
+    let (t, _) = tcs();
+    let mut u16s = Vec::new();
+    let mut v = Vec::with_capacity(src.len());
+    for (i, s) in src.iter().enumerate() {
+        if !mix {
+            v.push(str_arg(s, t));
+            continue;
+        }
+        match i % 4 {
+            0 => v.push(str_arg(s, t)),
+            1 => v.push(str_arg(s, unsafe { ak_tc_utf8() })),
+            2 => v.push(str_arg(s, unsafe { ak_tc_latin1() })),
+            _ => {
+                let w: Vec<u16> = s.encode_utf16().collect();
+                u16s.push(w);
+                let w = u16s.last().unwrap();
+                v.push(ak_str {
+                    data: if w.is_empty() { core::ptr::null() } else { w.as_ptr() as *const c_void },
+                    len: w.len(),
+                    tc: Some(unsafe { ak_tc_utf16() }),
+                });
+            }
+        }
+    }
+    StrArgs { v, _u16: u16s }
+}
+
+// ------------------------------------------------------------------ M1: a leaf element
+
+unsafe extern "C" fn m1_loop(ctx: *mut ak_enc_ctx, obj: *const c_void, _tok: i64) -> i32 {
+    let o = &*(obj as *const facade::ListResultsResponse);
+    let tc = tcs();
+    deliver(ctx, o.results.len(), |start, n| {
+        let g: Vec<ak_efix_ResultRaw> = o.results[start..start + n].iter().map(|r| make_result_raw(r, tc)).collect();
+        ak_elem_ResultRaw(ctx, g.as_ptr(), n as i32)
+    })
+}
+
+pub unsafe fn enc_m1(ctx: *mut ak_enc_ctx, o: &facade::ListResultsResponse) -> Result<Vec<u8>, i32> {
+    let t = Tcs::trusted();
+    TCS.with(|c| c.set((Some(t.utf8), Some(t.bytes))));
+    ak_enc_reset(ctx);
+    let vt = ak_evt_ListResultsResponse { loop_results: Some(m1_loop) };
+    let fix = make_list_results_response(o, (t.utf8, t.bytes));
+    let rc = ak_encode_ListResultsResponse(o as *const _ as *const c_void, ctx, &vt, &fix);
+    if rc < 0 {
+        return Err(rc as i32);
+    }
+    Ok(encoded(ctx).to_vec())
+}
+
+// ------------------------------------------------------------------ M2: a non-leaf element
+
+unsafe extern "C" fn m2_tasks(ctx: *mut ak_enc_ctx, obj: *const c_void, _tok: i64) -> i32 {
+    let o = &*(obj as *const facade::ListTasksDetailedResponse);
+    let tc = tcs();
+    deliver(ctx, o.tasks.len(), |start, n| {
+        let g: Vec<ak_efix_TaskDetailed> = o.tasks[start..start + n].iter().map(|t| make_task_detailed(t, tc)).collect();
+        ak_elemu_TaskDetailed(ctx, g.as_ptr(), n as i32, start as i64)
+    })
+}
+
+unsafe fn strs(ctx: *mut ak_enc_ctx, src: &[String]) -> i32 {
+    let a = str_args(src);
+    deliver(ctx, src.len(), |start, n| ak_blob_run(ctx, a.v.as_ptr().add(start), n as i32))
+}
+
+macro_rules! inner_strs {
+    ($name:ident, $field:ident) => {
+        unsafe extern "C" fn $name(ctx: *mut ak_enc_ctx, obj: *const c_void, tok: i64) -> i32 {
+            let o = &*(obj as *const facade::ListTasksDetailedResponse);
+            strs(ctx, &o.tasks[tok as usize].$field)
+        }
+    };
+}
+inner_strs!(m2_parents, parent_task_ids);
+inner_strs!(m2_deps, data_dependencies);
+inner_strs!(m2_outs, expected_output_ids);
+inner_strs!(m2_retry, retry_of_ids);
+
+unsafe extern "C" fn m2_options(ctx: *mut ak_enc_ctx, obj: *const c_void, tok: i64) -> i32 {
+    let o = &*(obj as *const facade::ListTasksDetailedResponse);
+    let Some(opts) = &o.tasks[tok as usize].options else { return AK_OK };
+    let (t, _) = tcs();
+    let kv: Vec<ak_efix_TaskOptionsOptionsEntry> = opts
+        .options
+        .iter()
+        .map(|(k, v)| ak_efix_TaskOptionsOptionsEntry { key: str_arg(k, t), value: str_arg(v, t), presence: 0 })
+        .collect();
+    deliver(ctx, kv.len(), |start, n| ak_elem_TaskOptionsOptionsEntry(ctx, kv.as_ptr().add(start), n as i32))
+}
+
+pub unsafe fn enc_m2(ctx: *mut ak_enc_ctx, o: &facade::ListTasksDetailedResponse) -> Result<Vec<u8>, i32> {
+    let t = Tcs::trusted();
+    TCS.with(|c| c.set((Some(t.utf8), Some(t.bytes))));
+    ak_enc_reset(ctx);
+    let evt = ak_evt_TaskDetailed {
+        loop_parent_task_ids: Some(m2_parents),
+        loop_data_dependencies: Some(m2_deps),
+        loop_expected_output_ids: Some(m2_outs),
+        loop_retry_of_ids: Some(m2_retry),
+        loop_options_options: Some(m2_options),
+    };
+    let vt = ak_evt_ListTasksDetailedResponse { loop_tasks: Some(m2_tasks), elem_tasks: &evt };
+    let fix = make_list_tasks_detailed_response(o, (t.utf8, t.bytes));
+    let rc = ak_encode_ListTasksDetailedResponse(o as *const _ as *const c_void, ctx, &vt, &fix);
+    if rc < 0 {
+        return Err(rc as i32);
+    }
+    Ok(encoded(ctx).to_vec())
+}
+
+// ------------------------------------------------------------------ M6: packed runs
+
+unsafe extern "C" fn m6_batches(ctx: *mut ak_enc_ctx, obj: *const c_void, _tok: i64) -> i32 {
+    let o = &*(obj as *const facade::ListMetricsResponse);
+    let tc = tcs();
+    deliver(ctx, o.batches.len(), |start, n| {
+        let g: Vec<ak_efix_MetricsBatch> = o.batches[start..start + n].iter().map(|b| make_metrics_batch(b, tc)).collect();
+        ak_elemu_MetricsBatch(ctx, g.as_ptr(), n as i32, start as i64)
+    })
+}
+fn batch(obj: *const c_void, tok: i64) -> &'static facade::MetricsBatch {
+    let o: &'static facade::ListMetricsResponse = unsafe { &*(obj as *const facade::ListMetricsResponse) };
+    &o.batches[tok as usize]
+}
+unsafe extern "C" fn m6_ticks(ctx: *mut ak_enc_ctx, obj: *const c_void, tok: i64) -> i32 {
+    let s = &batch(obj, tok).ticks;
+    deliver(ctx, s.len(), |a, n| ak_run_i64(ctx, s.as_ptr().add(a), n))
+}
+unsafe extern "C" fn m6_values(ctx: *mut ak_enc_ctx, obj: *const c_void, tok: i64) -> i32 {
+    let s = &batch(obj, tok).values;
+    deliver(ctx, s.len(), |a, n| ak_run_f64(ctx, s.as_ptr().add(a), n))
+}
+unsafe extern "C" fn m6_codes(ctx: *mut ak_enc_ctx, obj: *const c_void, tok: i64) -> i32 {
+    let s = &batch(obj, tok).codes;
+    deliver(ctx, s.len(), |a, n| ak_run_i32(ctx, s.as_ptr().add(a), n))
+}
+unsafe extern "C" fn m6_flags(ctx: *mut ak_enc_ctx, obj: *const c_void, tok: i64) -> i32 {
+    let s = &batch(obj, tok).flags;
+    deliver(ctx, s.len(), |a, n| ak_run_u8(ctx, s.as_ptr().add(a) as *const u8, n))
+}
+unsafe extern "C" fn m6_statuses(ctx: *mut ak_enc_ctx, obj: *const c_void, tok: i64) -> i32 {
+    let s: Vec<i32> = batch(obj, tok).statuses.iter().map(|x| x.to_i32()).collect();
+    deliver(ctx, s.len(), |a, n| ak_run_i32(ctx, s.as_ptr().add(a), n))
+}
+
+pub unsafe fn enc_m6(ctx: *mut ak_enc_ctx, o: &facade::ListMetricsResponse) -> Result<Vec<u8>, i32> {
+    let t = Tcs::trusted();
+    TCS.with(|c| c.set((Some(t.utf8), Some(t.bytes))));
+    ak_enc_reset(ctx);
+    let evt = ak_evt_MetricsBatch {
+        loop_ticks: Some(m6_ticks),
+        loop_values: Some(m6_values),
+        loop_codes: Some(m6_codes),
+        loop_flags: Some(m6_flags),
+        loop_statuses: Some(m6_statuses),
+    };
+    let vt = ak_evt_ListMetricsResponse { loop_batches: Some(m6_batches), elem_batches: &evt };
+    let fix = make_list_metrics_response(o, (t.utf8, t.bytes));
+    let rc = ak_encode_ListMetricsResponse(o as *const _ as *const c_void, ctx, &vt, &fix);
+    if rc < 0 {
+        return Err(rc as i32);
+    }
+    Ok(encoded(ctx).to_vec())
+}
+
+// ------------------------------------------------------------------ the checks
+
+pub struct Report {
+    pub pass: usize,
+    pub fail: usize,
+}
+impl Report {
+    fn check(&mut self, name: &str, ok: bool, detail: String) {
+        if ok {
+            self.pass += 1;
+            println!("PASS {name}: {detail}");
+        } else {
+            self.fail += 1;
+            println!("FAIL {name}: {detail}");
+        }
+    }
+}
+
+fn set(f: Form, mix: bool) {
+    FORM.with(|c| c.set(f));
+    MIX_TC.with(|c| c.set(mix));
+    FAIL_AT.with(|c| c.set(-1));
+    CALLS.with(|c| c.set(0));
+}
+
+const FORMS: [Form; 5] = [Form::Whole, Form::One, Form::Chunk(8), Form::Chunk(32), Form::Mixed];
+
+fn fresh() -> *mut ak_enc_ctx {
+    let rc = ak_init_once();
+    assert!(rc >= 0);
+    unsafe { ak_enc_ctx_new() }
+}
+
+pub fn run() -> Report {
+    let mut r = Report { pass: 0, fail: 0 };
+    let ctx = fresh();
+
+    // ---- M1 (repeated leaf message, nested Timestamps inside every element)
+    for pid in ["P1.1", "P1.2", "P1.3"] {
+        let v = crate::arms::armonik_arm::value(pid);
+        let want = crate::arms::armonik_arm::encode(&v);
+        for f in FORMS {
+            set(f, false);
+            // warm context, and a FRESH one (4 KiB: grows mid-field, mid-element)
+            let got = unsafe { enc_m1(ctx, &v) };
+            let c2 = fresh();
+            let got2 = unsafe { enc_m1(c2, &v) };
+            unsafe { ak_enc_ctx_free(c2) };
+            r.check(&format!("M1 {pid} {f:?}"), got.as_deref() == Ok(&want[..]) && got2.as_deref() == Ok(&want[..]),
+                    format!("{} B, warm and fresh context", want.len()));
+        }
+    }
+
+    // ---- M2 (non-leaf element: tokens, inner string fields, the options map) + transcoders
+    for pid in crate::arms_m2::ALL {
+        let v = crate::arms_m2::armonik_arm::value(pid);
+        let want = crate::arms_m2::armonik_arm::encode(&v);
+        for f in FORMS {
+            for mix in [false, true] {
+                set(f, mix);
+                let got = unsafe { enc_m2(ctx, &v) };
+                let c2 = fresh();
+                let got2 = unsafe { enc_m2(c2, &v) };
+                unsafe { ak_enc_ctx_free(c2) };
+                r.check(&format!("M2 {pid} {f:?}{}", if mix { " mixed-transcoders" } else { "" }),
+                        got.as_deref() == Ok(&want[..]) && got2.as_deref() == Ok(&want[..]),
+                        format!("{} B, warm and fresh context", want.len()));
+            }
+        }
+    }
+
+    // ---- M6 (packed runs in several calls: several packed records, decoded by prost)
+    {
+        let v = crate::arms_rest::m6::facade_value("P6.1");
+        let want = crate::arms_rest::m6::armonik_encode(&v);
+        for f in FORMS {
+            set(f, false);
+            let got = unsafe { enc_m6(ctx, &v) };
+            let ok = match &got {
+                Ok(b) if f == Form::Whole => b == &want,
+                Ok(b) => crate::arms_rest::m6::armonik_decode(b) == v,
+                Err(_) => false,
+            };
+            r.check(&format!("M6 P6.1 {f:?}"), ok,
+                    if f == Form::Whole { format!("{} B byte-identical", want.len()) }
+                    else { format!("{} B, several packed records per field, prost decode == value", got.as_ref().map(|b| b.len()).unwrap_or(0)) });
+        }
+    }
+
+    // ---- M5: the direct argument inside a nested message, fresh context (a grow inside
+    // the nested `upload` message, for the 1 and 4 MiB payloads)
+    for pid in ["P5.1", "P5.2", "P5.3", "P5.4"] {
+        let v = crate::arms_rest::m5::facade_value(pid);
+        let want = crate::arms_rest::m5::armonik_encode(&v);
+        let c = crate::arms::core_ffi_arm::Ctx::new();
+        let got = crate::arms_rest::ffi::enc_m5(&c, &v).to_vec();
+        r.check(&format!("M5 {pid} fresh context"), got == want, format!("{} B", want.len()));
+    }
+
+    // ---- rollback: ak_fail mid-field (after 3 element calls), then the same context
+    // encodes correctly; an element call after the failure gets the sticky code
+    for (pid, at) in [("P1.2", 3i64), ("P2.2", 5), ("P2.2", 40)] {
+        let ok = unsafe {
+            if pid == "P1.2" {
+                let v = crate::arms::armonik_arm::value(pid);
+                let want = crate::arms::armonik_arm::encode(&v);
+                set(Form::Chunk(8), false);
+                FAIL_AT.with(|c| c.set(at));
+                let e = enc_m1(ctx, &v);
+                let sticky = ak_enc_err(ctx);
+                let after = ak_elem_ResultRaw(ctx, [ak_efix_ResultRaw::ZERO].as_ptr(), 1);
+                set(Form::Chunk(8), false);
+                let again = enc_m1(ctx, &v);
+                e == Err(AK_ERR_HOST) && sticky == AK_ERR_HOST && after == AK_ERR_HOST && again.as_deref() == Ok(&want[..])
+            } else {
+                let v = crate::arms_m2::armonik_arm::value(pid);
+                let want = crate::arms_m2::armonik_arm::encode(&v);
+                set(Form::Mixed, true);
+                FAIL_AT.with(|c| c.set(at));
+                let e = enc_m2(ctx, &v);
+                let sticky = ak_enc_err(ctx);
+                set(Form::Mixed, true);
+                let again = enc_m2(ctx, &v);
+                e == Err(AK_ERR_HOST) && sticky == AK_ERR_HOST && again.as_deref() == Ok(&want[..])
+            }
+        };
+        r.check(&format!("rollback {pid} ak_fail at element call {at}"), ok,
+                "encode returns AK_ERR_HOST, sticky, next encode on the same context byte-identical".into());
+    }
+
+    // ---- a transcoder that writes past its capacity: AK_ERR_CAPACITY, then a clean encode
+    {
+        unsafe extern "C" fn over(_s: *const c_void, _l: usize, _d: *mut u8, cap: i32, _g: ak_grow_fn, _k: *mut c_void) -> i32 {
+            cap + 1
+        }
+        let v = crate::arms_m2::armonik_arm::value("P2.1");
+        let want = crate::arms_m2::armonik_arm::encode(&v);
+        let ok = unsafe {
+            let t = Tcs::trusted();
+            TCS.with(|c| c.set((Some(over as ak_transcode_fn), Some(t.bytes))));
+            ak_enc_reset(ctx);
+            set(Form::Whole, false);
+            let evt = ak_evt_TaskDetailed {
+                loop_parent_task_ids: Some(m2_parents), loop_data_dependencies: Some(m2_deps),
+                loop_expected_output_ids: Some(m2_outs), loop_retry_of_ids: Some(m2_retry),
+                loop_options_options: Some(m2_options),
+            };
+            let vt = ak_evt_ListTasksDetailedResponse { loop_tasks: Some(m2_tasks), elem_tasks: &evt };
+            let fix = make_list_tasks_detailed_response(&v, (over, t.bytes));
+            let rc = ak_encode_ListTasksDetailedResponse(&v as *const _ as *const c_void, ctx, &vt, &fix);
+            let again = enc_m2(ctx, &v);
+            rc == AK_ERR_CAPACITY as isize && again.as_deref() == Ok(&want[..])
+        };
+        r.check("transcoder over capacity", ok, "AK_ERR_CAPACITY, then a byte-identical encode on the same context".into());
+    }
+
+    unsafe { ak_enc_ctx_free(ctx) };
+    r
+}
