@@ -0,0 +1,635 @@
+//! EXPERIMENT `backward-encode` (ffi/logs/rust/opt/patches/backward-encode/): the encode
+//! buffer of the core written BACKWARD, as upb does ("We encode backwards, to avoid
+//! pre-computing lengths (one-pass encode)", upb/wire/encode.c).
+//!
+//! The cursor moves toward the start of the buffer; the encoded message is `[pos, cap)`.
+//! A length-delimited field is written body first, then its length (now known), then its
+//! key, so there is no placeholder, no learned width and no prefix move on a miss: the
+//! widths table, `pad-widths` and `global-widths` have nothing to act on in this buffer.
+//! Every position the generated code records is a DISTANCE FROM THE END (`BMark`), so it
+//! survives a grow, which allocates a larger buffer (geometric: at least twice the old
+//! capacity) and copies the content to the END of the new one.
+//!
+//! `ak_rt::Enc` (the forward buffer) is untouched: core-native, the unchanged reference
+//! arm, keeps using it. Only the core behind the C ABI uses this type.
+
+use crate::counters::Counters;
+use crate::{key, varint_len, WIRE_I32, WIRE_I64, WIRE_LEN, WIRE_VARINT};
+use bytes::Bytes;
+use std::sync::{Arc, Mutex};
+
+pub use crate::enc::{FRAME_HEAD, SPARES};
+
+/// An open length-delimited field: how many bytes had been written when it was opened. A
+/// distance from the end of the buffer, so it is still right after a grow.
+#[derive(Clone, Copy)]
+pub struct BMark(usize);
+
+/// Counting build only: what the backward core did that the forward one did not (or did
+/// differently), per context. Not part of `AkCounters` (an ABI struct): read through the
+/// additive count-only export `ak_enc_bwd_counters`.
+#[derive(Clone, Copy, Default, Debug)]
+pub struct BwdCounters {
+    /// Element entry calls (`ak_elem*`, `ak_elemu*`, `ak_blob_run`, `ak_run_*`): every one
+    /// is now delivered by the host in reverse element order.
+    pub elem_calls: u64,
+    /// Elements those calls carried (a run's values count one each).
+    pub elem_items: u64,
+    /// Calls with more than one element, whose array the codec walked last to first.
+    pub multi_calls: u64,
+    /// Transcoder outputs moved to just below the cursor after `commit` (the length was
+    /// not known before the transcode), and the bytes moved.
+    pub tc_moves: u64,
+    pub tc_move_bytes: u64,
+    /// Grows, and the bytes they copied (content to the end of the new buffer).
+    pub grows: u64,
+    pub grow_bytes: u64,
+}
+
+/// A taken body: its buffer returns to the context's spare ring when the last `Bytes`
+/// clone is dropped (the forward buffer's `Recycle`, with the start of the message).
+struct Recycle {
+    v: Vec<u8>,
+    start: usize,
+    slot: Arc<Mutex<Vec<Vec<u8>>>>,
+}
+impl AsRef<[u8]> for Recycle {
+    fn as_ref(&self) -> &[u8] {
+        // [start, capacity) was written by the encode before the take; `v` is never touched
+        // again until it comes back to the ring.
+        unsafe { core::slice::from_raw_parts(self.v.as_ptr().add(self.start), self.v.capacity() - self.start) }
+    }
+}
+impl Drop for Recycle {
+    fn drop(&mut self) {
+        if let Ok(mut g) = self.slot.lock() {
+            if g.len() < SPARES {
+                g.push(core::mem::take(&mut self.v));
+            }
+        }
+    }
+}
+
+/// Store `v` as a varint at `p` (forward); returns its length.
+#[inline(always)]
+unsafe fn put_varint(p: *mut u8, mut v: u64) -> usize {
+    let mut i = 0usize;
+    while v >= 0x80 {
+        *p.add(i) = (v as u8) | 0x80;
+        v >>= 7;
+        i += 1;
+    }
+    *p.add(i) = v as u8;
+    i + 1
+}
+
+pub struct BEnc {
+    /// The storage: its CAPACITY is the buffer, its length stays 0 (every byte is written
+    /// through raw pointers before it is read, so no initialisation is paid).
+    v: Vec<u8>,
+    cap: usize,
+    /// The cursor: the encoded message is `[pos, cap)`.
+    pos: usize,
+    /// Bytes kept free at the START of the buffer: FRAME_HEAD on a core context, so
+    /// `take_framed` can write the gRPC prefix just below the message.
+    pub head: usize,
+    spare: Arc<Mutex<Vec<Vec<u8>>>>,
+    pub c: Counters,
+    #[cfg(feature = "count")]
+    pub bc: BwdCounters,
+    /// Sticky, first error wins (ABI v1 section 5).
+    pub err: i32,
+    /// The capacity most recently handed to a transcoder (ABI v1 section 4's one check).
+    pub last_cap: i32,
+    /// Where the region handed to the transcoder starts (an offset from the start).
+    tc_at: usize,
+}
+
+impl Default for BEnc {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl BEnc {
+    pub fn new() -> Self {
+        let v: Vec<u8> = Vec::with_capacity(4096);
+        let cap = v.capacity();
+        BEnc {
+            v,
+            cap,
+            pos: cap,
+            head: 0,
+            spare: Arc::new(Mutex::new(Vec::with_capacity(SPARES))),
+            c: Counters::default(),
+            #[cfg(feature = "count")]
+            bc: BwdCounters::default(),
+            err: 0,
+            last_cap: 0,
+            tc_at: 0,
+        }
+    }
+
+    #[inline(always)]
+    fn base(&mut self) -> *mut u8 {
+        self.v.as_mut_ptr()
+    }
+
+    #[inline]
+    pub fn reset(&mut self) {
+        self.pos = self.cap;
+        self.err = 0;
+    }
+
+    /// Bytes written so far.
+    #[inline(always)]
+    pub fn written(&self) -> usize {
+        self.cap - self.pos
+    }
+
+    /// The encoded message.
+    #[inline]
+    pub fn msg(&self) -> &[u8] {
+        unsafe { core::slice::from_raw_parts(self.v.as_ptr().add(self.pos), self.cap - self.pos) }
+    }
+
+    #[inline]
+    pub fn msg_len(&self) -> usize {
+        self.cap - self.pos
+    }
+
+    #[inline]
+    pub fn capacity(&self) -> usize {
+        self.cap
+    }
+
+    #[inline]
+    pub fn fail(&mut self, code: i32) {
+        if self.err == 0 {
+            self.err = code;
+        }
+    }
+
+    /// Make room for `n` more bytes below the cursor (above `head`).
+    #[inline(always)]
+    fn need(&mut self, n: usize) {
+        if self.pos - self.head < n {
+            self.grow_by(n, 0);
+        }
+    }
+
+    /// Geometric grow: a new buffer of at least max(2 x capacity, written + n + head), the
+    /// content copied to its END. `keep` bytes starting at `tc_at` (a transcoder's partial
+    /// output) are copied to the start of the new free region.
+    #[cold]
+    #[inline(never)]
+    fn grow_by(&mut self, n: usize, keep: usize) {
+        let w = self.cap - self.pos;
+        let want = (self.cap.saturating_mul(2)).max(w + n + self.head).max(64);
+        let mut nv: Vec<u8> = Vec::with_capacity(want);
+        let ncap = nv.capacity();
+        unsafe {
+            let src = self.v.as_ptr();
+            let dst = nv.as_mut_ptr();
+            core::ptr::copy_nonoverlapping(src.add(self.pos), dst.add(ncap - w), w);
+            if keep != 0 {
+                core::ptr::copy_nonoverlapping(src.add(self.tc_at), dst.add(self.head), keep);
+            }
+        }
+        #[cfg(feature = "count")]
+        {
+            self.bc.grows += 1;
+            self.bc.grow_bytes += (w + keep) as u64;
+        }
+        self.v = nv;
+        self.cap = ncap;
+        self.pos = ncap - w;
+        self.tc_at = self.head;
+    }
+
+    /// Prepend raw bytes (an unknown-field bag, verbatim).
+    #[inline(always)]
+    pub fn put(&mut self, b: &[u8]) {
+        let n = b.len();
+        self.need(n);
+        self.pos -= n;
+        unsafe { core::ptr::copy_nonoverlapping(b.as_ptr(), self.base().add(self.pos), n) };
+    }
+
+    #[inline(always)]
+    pub fn varint(&mut self, v: u64) {
+        let n = varint_len(v);
+        self.need(n);
+        self.pos -= n;
+        unsafe { put_varint(self.base().add(self.pos), v) };
+    }
+
+    #[inline(always)]
+    pub fn key(&mut self, tag: u32, wire: u32) {
+        self.varint(key(tag, wire));
+    }
+
+    #[inline(always)]
+    pub fn varint_field(&mut self, tag: u32, v: u64) {
+        let k = key(tag, WIRE_VARINT);
+        let kl = varint_len(k);
+        let n = kl + varint_len(v);
+        self.need(n);
+        self.pos -= n;
+        unsafe {
+            let p = self.base().add(self.pos);
+            put_varint(p, k);
+            put_varint(p.add(kl), v);
+        }
+    }
+
+    #[inline(always)]
+    pub fn f64_field(&mut self, tag: u32, v: f64) {
+        let k = key(tag, WIRE_I64);
+        let kl = varint_len(k);
+        self.need(kl + 8);
+        self.pos -= kl + 8;
+        unsafe {
+            let p = self.base().add(self.pos);
+            put_varint(p, k);
+            core::ptr::copy_nonoverlapping(v.to_le_bytes().as_ptr(), p.add(kl), 8);
+        }
+    }
+
+    #[inline(always)]
+    pub fn fixed32_field(&mut self, tag: u32, v: u32) {
+        let k = key(tag, WIRE_I32);
+        let kl = varint_len(k);
+        self.need(kl + 4);
+        self.pos -= kl + 4;
+        unsafe {
+            let p = self.base().add(self.pos);
+            put_varint(p, k);
+            core::ptr::copy_nonoverlapping(v.to_le_bytes().as_ptr(), p.add(kl), 4);
+        }
+    }
+
+    /// A length-delimited field whose length is known: placed directly at cursor - total,
+    /// written forward (key, length, body) in one pass, no move.
+    #[inline(always)]
+    pub unsafe fn blob_known(&mut self, tag: u32, data: *const u8, len: usize) {
+        let k = key(tag, WIRE_LEN);
+        let kl = varint_len(k);
+        let ll = varint_len(len as u64);
+        let total = kl + ll + len;
+        self.need(total);
+        self.pos -= total;
+        let p = self.base().add(self.pos);
+        put_varint(p, k);
+        put_varint(p.add(kl), len as u64);
+        // R-D9: an empty host string may arrive as (NULL, 0).
+        if len != 0 {
+            core::ptr::copy_nonoverlapping(data, p.add(kl + ll), len);
+        }
+    }
+
+    /// Reserve exactly `total` bytes below the cursor and return where they start, for a
+    /// caller that writes them forward itself (a passthrough blob run whose size it summed).
+    #[inline(always)]
+    pub unsafe fn hole(&mut self, total: usize) -> *mut u8 {
+        self.need(total);
+        self.pos -= total;
+        self.base().add(self.pos)
+    }
+
+    /// Open a length-delimited field: its body is written next (backward), then `close`.
+    #[inline(always)]
+    pub fn open(&mut self) -> BMark {
+        BMark(self.cap - self.pos)
+    }
+
+    /// Close it: the body's length is now known, so the length and the key are written in
+    /// front of it. Never a placeholder, never a move.
+    #[inline(always)]
+    pub fn close(&mut self, m: BMark, tag: u32) {
+        let body = (self.cap - self.pos) - m.0;
+        self.len_key(body, tag);
+    }
+
+    /// The length `body` and the key of a length-delimited field, in front of its body.
+    #[inline(always)]
+    pub fn len_key(&mut self, body: usize, tag: u32) {
+        let k = key(tag, WIRE_LEN);
+        let kl = varint_len(k);
+        let n = kl + varint_len(body as u64);
+        self.need(n);
+        self.pos -= n;
+        unsafe {
+            let p = self.base().add(self.pos);
+            put_varint(p, k);
+            put_varint(p.add(kl), body as u64);
+        }
+    }
+
+    /// A packed run of varints, walked LAST TO FIRST (each value below the cursor): one
+    /// reservation for the run (at most 10 bytes a value), then raw stores.
+    #[inline(always)]
+    pub fn varint_run_rev<I: DoubleEndedIterator<Item = u64>>(&mut self, n: usize, it: I) {
+        self.need(n.saturating_mul(10));
+        unsafe {
+            let base = self.base();
+            let mut at = self.pos;
+            for v in it.rev() {
+                at -= varint_len(v);
+                put_varint(base.add(at), v);
+            }
+            self.pos = at;
+        }
+    }
+
+    /// A packed run of doubles: the host's array is contiguous and little-endian, so it is
+    /// one copy into the region below the cursor (the bytes of a forward array placed as one
+    /// block are in forward order; nothing to walk).
+    #[inline(always)]
+    pub fn f64_run(&mut self, v: &[f64]) {
+        let n = v.len() * 8;
+        self.need(n);
+        self.pos -= n;
+        #[cfg(target_endian = "little")]
+        unsafe {
+            core::ptr::copy_nonoverlapping(v.as_ptr() as *const u8, self.base().add(self.pos), n);
+        }
+        #[cfg(not(target_endian = "little"))]
+        unsafe {
+            let p = self.base().add(self.pos);
+            for (i, x) in v.iter().enumerate() {
+                core::ptr::copy_nonoverlapping(x.to_le_bytes().as_ptr(), p.add(8 * i), 8);
+            }
+        }
+    }
+
+    /// What a transcoder of unknown output length is handed: the whole free region below
+    /// the cursor, starting at its bottom (ABI v1 section 4: the whole remaining buffer, not
+    /// a reservation). It writes FORWARD from there; `commit` then moves its n bytes up to
+    /// just below the cursor.
+    #[inline(always)]
+    pub fn space(&mut self) -> (*mut u8, i32) {
+        self.tc_at = self.head;
+        let cap = (self.pos - self.head).min(i32::MAX as usize) as i32;
+        self.last_cap = cap;
+        (unsafe { self.base().add(self.head) }, cap)
+    }
+
+    /// For a transcoder whose output length on success is known before the call (the core's
+    /// validating UTF-8 passthroughs: n == len): the region is exactly `len` bytes ending at
+    /// the cursor, so the output lands in place and `commit` moves nothing.
+    #[inline(always)]
+    pub fn space_known(&mut self, len: usize) -> (*mut u8, i32) {
+        self.need(len);
+        self.tc_at = self.pos - len;
+        self.last_cap = len as i32;
+        let at = self.tc_at;
+        (unsafe { self.base().add(at) }, len as i32)
+    }
+
+    /// The transcoder asked for more. May move the buffer; whatever the transcoder already
+    /// wrote at the start of its region is carried to the start of the new one.
+    #[inline]
+    pub fn grow(&mut self, want: i32) -> (*mut u8, i32) {
+        let want = want.max(0) as usize;
+        let have = self.pos - self.tc_at;
+        if have < want {
+            // A grow from inside a transcode keeps the region handed out so far (`have`
+            // bytes, fewer than `want`), then hands out the new free region from its bottom.
+            self.grow_by(want.max(self.pos - self.head), have);
+        } else if self.tc_at != self.head {
+            // A space_known region asked for more although it had enough: hand out the
+            // whole free region, carrying what was written.
+            unsafe {
+                let b = self.base();
+                core::ptr::copy(b.add(self.tc_at), b.add(self.head), have);
+            }
+            self.tc_at = self.head;
+        }
+        crate::bump!(self.c, grows);
+        self.tc_at = self.head;
+        let cap = (self.pos - self.head).min(i32::MAX as usize) as i32;
+        self.last_cap = cap;
+        (unsafe { self.base().add(self.head) }, cap)
+    }
+
+    /// Accept what a transcoder wrote: refuse a count larger than the capacity it was given
+    /// (AK_ERR_CAPACITY, ABI v1 section 4), else move the n bytes to just below the cursor
+    /// (nothing moves when they are already there).
+    #[inline(always)]
+    pub fn commit(&mut self, n: usize) -> bool {
+        if n > self.last_cap as usize {
+            self.fail(crate::ERR_CAPACITY);
+            return false;
+        }
+        let dst = self.pos - n;
+        if self.tc_at != dst {
+            unsafe {
+                let b = self.base();
+                core::ptr::copy(b.add(self.tc_at), b.add(dst), n);
+            }
+            #[cfg(feature = "count")]
+            {
+                self.bc.tc_moves += 1;
+                self.bc.tc_move_bytes += n as u64;
+            }
+        }
+        self.pos = dst;
+        true
+    }
+
+    /// Counting build: one element entry call carrying `n` elements.
+    #[inline(always)]
+    pub fn count_elem_call(&mut self, n: usize) {
+        #[cfg(feature = "count")]
+        {
+            self.bc.elem_calls += 1;
+            self.bc.elem_items += n as u64;
+            if n > 1 {
+                self.bc.multi_calls += 1;
+            }
+        }
+        let _ = n;
+    }
+
+    /// The encoded message as a `Bytes`, MOVED out (no copy), its buffer returned to the
+    /// spare ring when dropped. The context continues on a spare (or a fresh buffer of the
+    /// same capacity while the spares are out).
+    pub fn take(&mut self) -> Bytes {
+        let at = self.pos;
+        self.take_from(at)
+    }
+
+    /// The message with its 5-byte gRPC prefix (flag 0, big-endian length) written just
+    /// below it, as ONE buffer, moved out like `take`. Requires `head` >= FRAME_HEAD (else
+    /// it is `take`, and the caller frames it itself).
+    pub fn take_framed(&mut self) -> Bytes {
+        if self.head < FRAME_HEAD {
+            return self.take();
+        }
+        let n = (self.cap - self.pos) as u32;
+        let at = self.pos - FRAME_HEAD;
+        unsafe {
+            let p = self.base().add(at);
+            *p = 0;
+            core::ptr::copy_nonoverlapping(n.to_be_bytes().as_ptr(), p.add(1), 4);
+        }
+        self.take_from(at)
+    }
+
+    fn take_from(&mut self, start: usize) -> Bytes {
+        let fresh = match self.spare.lock().ok().and_then(|mut g| g.pop()) {
+            Some(v) => v,
+            None => Vec::with_capacity(self.cap),
+        };
+        let v = core::mem::replace(&mut self.v, fresh);
+        self.cap = self.v.capacity();
+        self.pos = self.cap;
+        Bytes::from_owner(Recycle { v, start, slot: self.spare.clone() })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The forward encoder's bytes for a message of `n` varint fields, written backward in
+    /// reverse field order: the same bytes.
+    fn fill_rev(e: &mut BEnc, n: usize) {
+        e.reset();
+        for i in (0..n).rev() {
+            e.varint_field(1, i as u64);
+        }
+    }
+
+    fn fill_fwd(n: usize) -> Vec<u8> {
+        let mut f = crate::Enc::new(1);
+        for i in 0..n {
+            f.varint_field(1, i as u64);
+        }
+        f.buf
+    }
+
+    #[test]
+    fn same_bytes_as_forward_across_grows() {
+        let mut e = BEnc::new();
+        let cap0 = e.capacity();
+        fill_rev(&mut e, 5000);
+        assert!(e.capacity() > cap0, "the test must cross a grow");
+        assert_eq!(e.msg(), &fill_fwd(5000)[..]);
+    }
+
+    #[test]
+    fn grow_is_geometric() {
+        let mut e = BEnc::new();
+        let mut caps = vec![e.capacity()];
+        e.reset();
+        for i in 0..100_000u64 {
+            e.varint_field(1, i);
+            if e.capacity() != *caps.last().unwrap() {
+                caps.push(e.capacity());
+            }
+        }
+        for w in caps.windows(2) {
+            assert!(w[1] >= 2 * w[0], "grow from {} to {} is not geometric", w[0], w[1]);
+        }
+    }
+
+    /// A nested message opened before a grow and closed after it: the mark is a distance
+    /// from the end, so the length is right.
+    #[test]
+    fn grow_inside_a_nested_message() {
+        let mut e = BEnc::new();
+        e.reset();
+        let m = e.open();
+        let big = vec![7u8; 10_000];
+        unsafe { e.blob_known(2, big.as_ptr(), big.len()) };
+        e.varint_field(1, 3);
+        e.close(m, 5);
+        let mut f = crate::Enc::new(1);
+        let mk = f.begin(5, 0);
+        f.varint_field(1, 3);
+        f.blob_field(2, &big);
+        f.end(mk);
+        assert_eq!(e.msg(), &f.buf[..]);
+    }
+
+    #[test]
+    fn transcoder_region_and_commit_move() {
+        let mut e = BEnc::new();
+        e.head = FRAME_HEAD;
+        e.reset();
+        e.varint_field(9, 1);
+        let (dst, cap) = e.space();
+        assert!(cap as usize >= 4000);
+        unsafe { core::ptr::copy_nonoverlapping(b"hello".as_ptr(), dst, 5) };
+        assert!(e.commit(5));
+        e.len_key(5, 2);
+        let mut f = crate::Enc::new(1);
+        f.blob_field(2, b"hello");
+        f.varint_field(9, 1);
+        assert_eq!(e.msg(), &f.buf[..]);
+        // over-capacity commit refused
+        let (_, cap) = e.space();
+        assert!(!e.commit(cap as usize + 1));
+        assert_eq!(e.err, crate::ERR_CAPACITY);
+    }
+
+    #[test]
+    fn transcoder_grow_keeps_partial_output() {
+        let mut e = BEnc::new();
+        e.reset();
+        // fill most of the buffer so the free region is small
+        let fill = vec![1u8; e.capacity() - 40];
+        e.put(&fill);
+        let (dst, cap) = e.space();
+        assert!(cap < 64);
+        unsafe { core::ptr::copy_nonoverlapping(b"abc".as_ptr(), dst, 3) };
+        let (dst2, cap2) = e.grow(1000);
+        assert!(cap2 >= 1000);
+        let got = unsafe { core::slice::from_raw_parts(dst2, 3) };
+        assert_eq!(got, b"abc");
+        unsafe { core::ptr::copy_nonoverlapping(b"def".as_ptr(), dst2.add(3), 3) };
+        assert!(e.commit(6));
+        let m = e.msg();
+        assert_eq!(&m[..6], b"abcdef");
+        assert_eq!(&m[6..], &fill[..]);
+    }
+
+    #[test]
+    fn take_framed_moves_and_recycles() {
+        let mut e = BEnc::new();
+        e.head = FRAME_HEAD;
+        fill_rev(&mut e, 3000);
+        let want = fill_fwd(3000);
+        let b = e.take_framed();
+        assert_eq!(b[0], 0);
+        assert_eq!(u32::from_be_bytes(b[1..5].try_into().unwrap()) as usize, want.len());
+        assert_eq!(&b[5..], &want[..]);
+        let p = b.as_ptr();
+        drop(b);
+        fill_rev(&mut e, 3000);
+        let b2 = e.take();
+        assert_eq!(&b2[..], &want[..]);
+        drop(b2);
+        fill_rev(&mut e, 3000);
+        // two buffers alternate through the ring: the first comes back after two takes
+        let b3 = e.take_framed();
+        assert_eq!(b3.as_ptr(), p, "the dropped body's buffer did not come back");
+    }
+
+    #[test]
+    fn packed_run_reverse_walk() {
+        let vals: Vec<i64> = (0..1000).map(|i| i * 977 - 300).collect();
+        let mut e = BEnc::new();
+        e.reset();
+        let m = e.open();
+        e.varint_run_rev(vals.len(), vals.iter().map(|&v| v as u64));
+        e.close(m, 4);
+        let mut f = crate::Enc::new(1);
+        let mk = f.begin(4, 0);
+        f.varint_run(vals.len(), vals.iter().map(|&v| v as u64));
+        f.end(mk);
+        assert_eq!(e.msg(), &f.buf[..]);
+    }
+}
