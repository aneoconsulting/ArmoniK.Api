+//! EXPERIMENT backward-encode: the checks of the reverse-delivery host contract
+//! (`harness::bwd_tests`) and, in a counting build, the backward core's own counters per
+//! payload: element calls (every one now delivered last to first), elements, calls whose
+//! array the codec walked last to first, transcoder moves and buffer grows.
+use ak_abi::*;
+use harness::generated::binding as b;
+
+extern "C" {
+    fn ak_enc_bwd_counters(ctx: *const ak_enc_ctx, out: *mut u64, cap: usize) -> usize;
+}
+
+fn counters_row(name: &str, mode: &str, ctx: *mut ak_enc_ctx, run: &dyn Fn()) {
+    unsafe {
+        run(); // warm (a fresh context grows on its first encode)
+        ak_enc_counters_reset(ctx);
+        run();
+        let mut c = core::mem::zeroed::<AkCounters>();
+        ak_enc_counters(ctx, &mut c);
+        let mut w = [0u64; 8];
+        let n = ak_enc_bwd_counters(ctx, w.as_mut_ptr(), w.len());
+        assert_eq!(n, 7, "not a counting build of the backward core");
+        let ok = w[0] == c.forward - 1;
+        println!("{name:<8} {mode:<7} {:>7} {:>8} {:>8} {:>8} {:>9} {:>6} {:>10}  {:>7} {}",
+                 w[0], w[1], w[2], w[3], w[4], w[5], w[6], c.forward, if ok { "ok" } else { "MISMATCH" });
+        if !ok { std::process::exit(1); }
+    }
+}
+
+fn main() {
+    let r = harness::bwd_tests::run();
+    println!("# bwd_check: {} passed, {} failed", r.pass, r.fail);
+    if r.fail > 0 {
+        println!("BWD CHECK FAILED");
+        std::process::exit(1);
+    }
+    if cfg!(feature = "count") {
+        println!();
+        println!("# per payload, one warm encode (the binding's loops: every field delivered last to first):");
+        println!("# elem_calls = element entry calls (ak_elem*/ak_elemu*/ak_blob_run/ak_run_*), each now in reverse order;");
+        println!("# items = elements they carried; multi = calls with n > 1 (array walked last to first by the codec);");
+        println!("# tc_moves/bytes = transcoder outputs moved after commit; grows/bytes = buffer grows (0 warm);");
+        println!("# core_fwd = the core-counted forward crossings (ak_enc_counters): elem_calls must equal core_fwd - 1 (the ak_encode_* call)");
+        println!("{:<8} {:<7} {:>7} {:>8} {:>8} {:>8} {:>9} {:>6} {:>10}  {:>7}", "payload", "mode", "calls", "items", "multi", "tc_moves", "tc_bytes", "grows", "grow_bytes", "core_fwd");
+        let c = harness::arms::core_ffi_arm::Ctx::new();
+        let t = &c.tcs;
+        let e = c.enc;
+        macro_rules! rows {
+            ($pid:expr, $v:expr, $f:ident, $fu:ident) => {{
+                let v = $v;
+                counters_row($pid, "drop", e, &|| { b::$f(e, &v, t).unwrap(); });
+                #[cfg(feature = "unknown-fields")]
+                counters_row($pid, "retain", e, &|| { b::$fu(e, &v, t).unwrap(); });
+            }};
+        }
+        for pid in ["P1.1", "P1.2", "P1.3"] {
+            rows!(pid, harness::arms::armonik_arm::value(pid), encode_into_list_results_response, encode_into_list_results_response_unk);
+        }
+        for pid in harness::arms_m2::ALL {
+            rows!(pid, harness::arms_m2::armonik_arm::value(pid), encode_into_list_tasks_detailed_response, encode_into_list_tasks_detailed_response_unk);
+        }
+        rows!("P3.1", harness::arms_m3::armonik_arm::value("P3.1"), encode_into_list_probe_response, encode_into_list_probe_response_unk);
+        rows!("P4.1", harness::arms_rest::m4::facade_value("P4.1"), encode_into_list_task_summary_response, encode_into_list_task_summary_response_unk);
+        for pid in ["P5.1", "P5.2", "P5.3", "P5.4"] {
+            rows!(pid, harness::arms_rest::m5::facade_value(pid), encode_into_upload_result_data_message, encode_into_upload_result_data_message_unk);
+        }
+        rows!("P6.1", harness::arms_rest::m6::facade_value("P6.1"), encode_into_list_metrics_response, encode_into_list_metrics_response_unk);
+    }
+    println!("BWD CHECK PASSED");
+}
