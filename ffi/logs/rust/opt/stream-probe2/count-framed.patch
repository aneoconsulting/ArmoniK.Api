+    k: std::sync::Arc<Kount>,
+}
+
+#[derive(Default)]
+struct Kount {
+    polls: std::sync::atomic::AtomicU64,
+    pending: std::sync::atomic::AtomicU64,
+    frames: std::sync::atomic::AtomicU64,
+    wakes: std::sync::atomic::AtomicU64,
+    threads: std::sync::Mutex<std::collections::BTreeMap<String, u64>>,
+}
+
+struct KWaker {
+    inner: std::task::Waker,
+    k: std::sync::Arc<Kount>,
+}
+impl std::task::Wake for KWaker {
+    fn wake(self: std::sync::Arc<Self>) {
+        self.k.wakes.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        self.inner.wake_by_ref();
+    }
+    fn wake_by_ref(self: &std::sync::Arc<Self>) {
+        self.k.wakes.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        self.inner.wake_by_ref();
+    }
+}
+
+impl<S> Drop for FramedStream<S> {
+    fn drop(&mut self) {
+        use std::sync::atomic::Ordering::Relaxed;
+        let k = &self.k;
+        eprintln!("[framed-count] polls={} pending={} frames={} inner_wakes={} threads={:?}", k.polls.load(Relaxed), k.pending.load(Relaxed),
+                  k.frames.load(Relaxed), k.wakes.load(Relaxed), k.threads.lock().unwrap());
+    }
 }
 
