# --- P.cs
using System; using System.Linq; using System.Reflection;
var asm = typeof(Grpc.Net.Client.GrpcChannel).Assembly;
foreach (var x in asm.GetTypes().Where(x => x.Name.Contains("Serializ"))) Console.WriteLine("T " + x.FullName); var t = asm.GetTypes().First(x => x.Name.Contains("SerializationContext") && !x.IsNested);
Console.WriteLine(t);
foreach (var m in t.GetMethods(BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.DeclaredOnly)) {
  var body = m.GetMethodBody(); if (body == null) continue;
  var il = body.GetILAsByteArray(); var calls = new System.Collections.Generic.List<string>();
  for (int i = 0; i < il.Length - 4; i++) if (il[i] == 0x28 || il[i] == 0x6F || il[i] == 0x73) { try { var mb = m.Module.ResolveMethod(BitConverter.ToInt32(il, i+1), t.GetGenericArguments(), null); calls.Add(mb.DeclaringType?.Name + "." + mb.Name); } catch {} }
  Console.WriteLine(m.Name + ": " + string.Join(", ", calls.Distinct()));
}
