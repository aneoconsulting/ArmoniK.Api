<?xml version="1.0" encoding="UTF-8"?>
<!-- Dependency resolution only. The slice compiles with javac against the classpath this
     resolves; it does not build through Maven, because the measured artifacts are plain
     class files and a JNI .so and neither needs a lifecycle.

     Versions are what packages/java pins (ffi/README R7): protobuf 3.19.0 and grpc 1.74.0.
     grpc-java 1.74 brings a newer protobuf-java of its own, and which one an ArmoniK Java
     consumer actually runs is the resolved one, so both are recorded and the resolved one
     is what the incumbent arm measures. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ffi.poc</groupId>
  <artifactId>java-slice-deps</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <properties>
    <grpc.version>1.74.0</grpc.version>
    <protobuf.version>3.19.0</protobuf.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>io.grpc</groupId><artifactId>grpc-netty-shaded</artifactId></dependency>
    <dependency><groupId>io.grpc</groupId><artifactId>grpc-protobuf</artifactId></dependency>
    <dependency><groupId>io.grpc</groupId><artifactId>grpc-stub</artifactId></dependency>
    <dependency>
      <groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
  </dependencies>
</project>
