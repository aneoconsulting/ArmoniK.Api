<Project Sdk="Microsoft.NET.Sdk">

  <!--
       README 5.2's RPC arm, which design/SHAPES.md specifies as END TO END:
       "the host's real gRPC stack against the core's, carrying P2.2". A
       marshaller arm is NOT one; calling a SerializationContext measures the
       codec path gRPC drives, which R14 asks for separately and which
       ../Harness already has as gp-marshaller.

       So this is a real grpc-dotnet client against a real grpc-dotnet server
       over a Unix domain socket, with the CODEC swapped underneath by supplying
       a different Marshaller. Everything above the marshaller (HTTP/2 framing,
       flow control, the ASP.NET pipeline, the client's call machinery) is
       identical across the arms, which is what makes the difference the codec's.

       UDS is not a measurement convenience here: packages/csharp defaults its
       worker and agent channels to GrpcSocketType.UnixDomainSocket at
       /tmp/armonik.sock and listens with ListenUnixSocket(HttpProtocols.Http2).
       So the primary row is what ArmoniK runs, and loopback TCP is the labelled
       second row.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>akrpc</AssemblyName>
    <RootNamespace>Armonik.Ffi.Rpc</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <!-- WP9 (CAMPAIGN req 22a as amended): the RPC grid on BenchmarkDotNet, as the codec suite. -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- CAMPAIGN section 4.0 as amended (b58543f7b): cell A's channel is ArmoniK's own,
       built by packages/csharp's GrpcChannelFactory.CreateChannel with the package defaults.
       The two assemblies are built from packages/csharp (unchanged) by gen/build_core.sh with
       dotnet's artifacts path under this slice (target-armonik-client/), nothing written under
       packages/; their package dependencies are the ones packages/csharp declares. -->
  <ItemGroup>
    <Reference Include="ArmoniK.Api.Client" HintPath="../../target-armonik-client/bin/ArmoniK.Api.Client/release_netstandard2.0/ArmoniK.Api.Client.dll" />
    <Reference Include="ArmoniK.Api.Common" HintPath="../../target-armonik-client/bin/ArmoniK.Api.Client/release_netstandard2.0/ArmoniK.Api.Common.dll" />
    <PackageReference Include="ArmoniK.Utils" Version="0.7.0" />
    <PackageReference Include="ArmoniK.Utils.DocAttribute" Version="0.7.0" />
    <PackageReference Include="Grpc.Net.Client.Web" Version="2.71.0" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Linq.AsyncEnumerable" Version="10.0.0" />
    <PackageReference Include="System.Net.Http.WinHttpHandler" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
         The arm table, the payload builders, the managed codec and the core-ffi
         binding all live in the harness project and are EMITTED from ffi/schema
         (R1), referenced rather than re-emitted, so the RPC arm cannot drift
         from the in-process one.
    -->
    <ProjectReference Include="../Harness/Harness.csproj" />
    <!-- The JIT tier read back (req 24, R-H2): the same listener the codec suite uses. -->
    <Compile Include="../BenchDotNet/JitTiers.cs" Link="Linked/JitTiers.cs" />
    <!-- WP7 (req 11, 12): the per-root ops and serializers, and the Grpc.Net frame, shared with
         the codec suite, so its encode-transport rows time the serializers cells A, D, F run. -->
    <Compile Include="../BenchDotNet/Generated/CampaignOps.cs" Link="Linked/CampaignOps.cs" />
    <Compile Include="../BenchDotNet/GrpcFrame.cs" Link="Linked/GrpcFrame.cs" />
    <Compile Include="../BenchDotNet/CpuClock.cs" Link="Linked/CpuClock.cs" />
  </ItemGroup>

</Project>
