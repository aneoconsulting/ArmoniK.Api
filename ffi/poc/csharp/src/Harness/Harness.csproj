<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- FIX-PLAN WP3 item 17: target net8.0, floor net6.0 (correctness only). One
         source tree: the generated binding carries LibraryImport under
         NET7_0_OR_GREATER and DllImport otherwise, so both levels build it. -->
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>harness</AssemblyName>
    <RootNamespace>Armonik.Ffi.Harness</RootNamespace>
    <Optimize>true</Optimize>
    <!-- R9: JIT tiering and PGO OFF handicaps a managed incumbent, so they stay
         ON, at their .NET 8 defaults, and the harness prints what they were. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The core-ffi arm: pointers into the by-value group, and LibraryImport's
         source generator, which needs a partial class. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- README 5.2 arm b: the FLOOR sources on the TARGET runtime, which is the
       only fair floor-against-target ratio there is. One define flipped, one
       generator, the same sources. Separate output paths so the two builds can
       be run round robin against each other rather than one after a rebuild. -->
  <PropertyGroup Condition="'$(AkFloor)' == 'true'">
    <DefineConstants>$(DefineConstants);AK_FLOOR</DefineConstants>
  </PropertyGroup>

  <!-- The counting build (R5). Kept behind a define so the measured build's hot
       path does not carry the per-site store: `dotnet build /p:AkCount=true`. -->
  <PropertyGroup Condition="'$(AkCount)' == 'true'">
    <DefineConstants>$(DefineConstants);AK_COUNT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.0" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- The incumbent's classes come from the SAME generated .proto the facade
         comes from, so no arm is reading a different description (R1). -->
    <Protobuf Include="../../../../schema/generated/shapes.proto"
              ProtoRoot="../../../../schema/generated"
              GrpcServices="None" Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Facade/Facade.csproj" />
  </ItemGroup>

  <!-- THE shared libak_core.so (README R0). Not a copy of its sources and not a
       second core. One native core with N bindings is the proposal, so the C# arm
       loads the artifact every other arm loads. This slice needed no copy even
       before R0, having already linked the Rust slice's build, so all that changed
       is the path: the core now lives in its own workspace rather than inside one
       slice's. Built by `ffi/poc/codec/gen/build.sh`, i.e. a release build of
       -p ak-core in ffi/poc/codec.

       One thing for this slice's own session to note: the shared crate builds
       WITHOUT the `rpc` feature by default, where the Rust slice's build had ABI v1
       section 9 compiled in unconditionally. The codec entry points this arm calls
       are identical; the shared object is smaller and carries no tonic. The C# arm
       was not re-gated for W10 in the aggregating session's container, which has no
       dotnet. It IS re-gated here: see ffi/logs/csharp/stage9-shared-core.log. -->
  <ItemGroup>
    <!-- W11 adds a SECOND acceptable location, and it is not a second core. ABI
         v1 section 9's transport lives behind the `rpc` cargo feature, which the
         shared build script does not pass by default, and building the shared
         `codec/target/` is not this slice's to do. So the same sources are built
         with CARGO_TARGET_DIR=poc/csharp/target-core and the rpc feature, which is
         exactly what the rust, cpp and java slices already do (see the comment in
         `codec/gen/build.sh`: each builds this crate into its own target dir with
         its own features). One core, N builds of it, which is what R0 says. The
         rpc build is PREFERRED when present because it is a superset: the codec
         entry points are identical and the transport is added, and the whole
         conformance and corpus gate is re-run against it. -->
    <None Include="../../target-core/release/libak_core.so"
          Condition="'$(AkNounk)' != 'true' And Exists('../../target-core/release/libak_core.so')"
          CopyToOutputDirectory="PreserveNewest" Link="libak_core.so" />
    <None Include="../../../codec/target/release/libak_core.so"
          Condition="'$(AkNounk)' != 'true' And !Exists('../../target-core/release/libak_core.so') And Exists('../../../codec/target/release/libak_core.so')"
          CopyToOutputDirectory="PreserveNewest" Link="libak_core.so" />
  </ItemGroup>



  <!-- WP5 step 10: the NO-UNKNOWN build loads the NO-UNKNOWN core (ak-core
       with default features off, its own target dir), never the full one. -->
  <ItemGroup Condition="'$(AkNounk)' == 'true'">
    <None Include="../../target-core-nounk/release/libak_core.so"
          Condition="Exists('../../target-core-nounk/release/libak_core.so')"
          CopyToOutputDirectory="PreserveNewest" Link="libak_core.so" />
  </ItemGroup>

  <!-- The corpus runner moved to ../Corpus (its own core build, the corpus feature). -->
  <ItemGroup>
    <Compile Remove="Corpus/**" />
  </ItemGroup>

</Project>
