<Project>
  <!-- FIX-PLAN WP5 step 10: the NO-UNKNOWN build's define (see Directory.Build.props). -->
  <PropertyGroup Condition="'$(AkNounk)' == 'true'">
    <DefineConstants>$(DefineConstants);AK_NO_UNKNOWN_FIELDS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AkHostCount)' == 'true'">
    <DefineConstants>$(DefineConstants);AK_HOST_COUNT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AkRoe)' == 'true'">
    <DefineConstants>$(DefineConstants);AK_ROE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AkRoeBench)' == 'true'">
    <DefineConstants>$(DefineConstants);AK_ROE_BENCH</DefineConstants>
  </PropertyGroup>
</Project>
