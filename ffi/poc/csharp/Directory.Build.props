<Project>

  <!-- README 5.2 arm b needs the FLOOR sources and the TARGET sources to exist
       side by side, so they can be run round robin rather than one after a
       rebuild: a comparison that cannot share a process still has to be taken
       in one sitting, with an in-process control column in each (R4).
       The output paths have to be redirected BEFORE the SDK's props are
       imported, which is why this is a Directory.Build.props and not a
       PropertyGroup in the csproj. The first spelling put the redirect after
       the default obj/ had already been globbed, and the build then compiled
       two copies of every generated assembly attribute. -->
  <PropertyGroup Condition="'$(AkFloor)' == 'true'">
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin-floor/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj-floor/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- The default **/*.cs glob excludes only $(BaseIntermediateOutputPath),
       which is obj/. With the floor build writing to obj-floor/, the TARGET
       build then globbed the floor build's generated assembly attributes and
       failed with a duplicate of every one of them, and then the FLOOR build
       globbed obj/ for the same reason, because the SDK only ever excludes the
       intermediate directory of the build currently running. Both are excluded
       in both directions, for every build. -->
  <!-- The AkStrict build (ABI v1 decision 3's rejecting policy as a separate output)
       is retired: the UTF-8 policy is the plan's option, rendered into the generated
       codec (FIX-PLAN WP5 step 4, R-E7). obj-strict/bin-strict stay excluded so an
       old tree cannot be globbed. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;obj-floor/**;bin-floor/**;obj-strict/**;bin-strict/**;obj-nounk/**;bin-nounk/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- FIX-PLAN WP5 step 10: the NO-UNKNOWN build, `dotnet build /p:AkNounk=true`. Unknown
       fields are COMPILED OUT: GeneratedNounk/ (rendered from the plans relowered with
       unknown="drop": no u-groups, no options, no resets, no capture in the managed codec)
       REPLACES the same files of Generated/, the define AK_NO_UNKNOWN_FIELDS is set
       (Directory.Build.targets), and the output goes to bin-nounk/ obj-nounk/, so both
       builds exist side by side. Not a run-time switch. -->
  <PropertyGroup Condition="'$(AkNounk)' == 'true'">
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin-nounk/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj-nounk/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);Generated/Abi.cs;Generated/CoreFfi.cs;Generated/CoreArms.cs;Generated/Codec.cs;Generated/Dispatch.cs;Generated/Types.cs;Generated/Eq.cs;Generated/CodecRetain.cs</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AkNounk)' != 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);GeneratedNounk/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
