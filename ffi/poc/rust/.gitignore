# Cargo build output, and the generator's bytecode cache. `ffi/.gitignore` re-includes
# `logs/**` and `poc/*/gen/**`.
target/
__pycache__/

# The repository-wide .gitignore excludes any directory named `[Bb]in/` (line 30, meant for
# .NET build output). That silently excluded EVERY measurement binary in this slice --
# conformance, counts, bench, content, shapes, rpcbench, decpolicy -- from stage 2 onward.
# The logs were committed and the code that produced them was not, which is the same defect
# as D11 with the sides swapped. Same class as `ffi/.gitignore`'s `logs/` and `gen/`
# re-inclusions, found the same way: by looking at what `git status` did NOT list.
!crates/*/src/bin/
!crates/*/src/bin/**
target-gw/
target-count/
target-ig/
target-pad/
target-gw-pad/
# WP4 item 1 / R-D1: this session's own CARGO_TARGET_DIR, kept off poc/codec/target so
# the core rebuild does not contend with the other slice agents.
target-r-d1/
